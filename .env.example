# Railway injects PORT automatically. 3000 is only the local fallback.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Railway PostgreSQL plugin -> DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_ai
DATABASE_SSL=false

# Admin dashboard secrets. Use long random values in production.
ADMIN_PASSWORD=change-this-now-with-a-strong-password
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# Mount Railway Persistent Volume at /data.
WHATSAPP_AUTH_DIR=/data/whatsapp
BOT_NAME=مساعدي
DEFAULT_DAILY_LIMIT=100
MAX_MEMORY_MESSAGES=16
MAX_UPLOAD_BYTES=15728640
MAX_REQUESTS_PER_MINUTE=12
WHATSAPP_AUTO_START=true
